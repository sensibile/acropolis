#!/usr/bin/env python3
"""Contract and isolated integration checks for the gate's real `gh` adapter.

`scripts/test-codex-review-gate` (copied from sensibile/taeguk) drives the gate
through `FakeGitHub`. This acropolis-only test runs each scenario twice: once on
the fake, recording every call and its answer, and once on the real `gh()`
adapter with a stub `gh` executable on PATH that replays those answers and
rejects any other argv. Both runs must make the same calls and end the same way.
That ties the fake to the subprocess boundary: argv passing, stdout decoding and
non-zero exits raised as CalledProcessError with stderr. Real GitHub API calls
need a token and network and are not covered.
"""

import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

if sys.flags.optimize:
    sys.exit("BLOCKED: gate tests require Python assertions; disable optimization")
sys.dont_write_bytecode = True

SOURCE = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader(
    "test_codex_review_gate", str(SOURCE / "scripts/test-codex-review-gate")
)
spec = importlib.util.spec_from_loader(loader.name, loader)
behavior = importlib.util.module_from_spec(spec)
loader.exec_module(behavior)
gate = behavior.gate
REPO = behavior.REPO

STUB = """#!/usr/bin/env python3
import json
import os
import sys

path = os.environ["STUB_GH_SCENARIO"]
with open(path, encoding="utf-8") as handle:
    data = json.load(handle)
position = data["position"]
steps = data["steps"]
if position >= len(steps) or steps[position]["argv"] != sys.argv[1:]:
    sys.stderr.write("STUB: unexpected gh call " + json.dumps(sys.argv[1:]))
    sys.exit(99)
step = steps[position]
data["position"] = position + 1
with open(path, "w", encoding="utf-8") as handle:
    json.dump(data, handle)
sys.stdout.write(step["stdout"])
sys.stderr.write(step["stderr"])
sys.exit(step["code"])
"""


class Recording:
    """Answers through a fake and keeps each call with its outcome."""

    def __init__(self, fake):
        self.fake = fake
        self.steps = []

    def __call__(self, *args):
        try:
            stdout = self.fake(*args)
        except subprocess.CalledProcessError as error:
            self.steps.append(
                {
                    "argv": list(args),
                    "stdout": "",
                    "stderr": error.stderr,
                    "code": error.returncode,
                }
            )
            raise
        self.steps.append(
            {"argv": list(args), "stdout": stdout, "stderr": "", "code": 0}
        )
        return stdout


def outcome(call, invalidate):
    try:
        return ("result", gate.run(REPO, 9, invalidate=invalidate, call=call))
    except subprocess.CalledProcessError as error:
        return ("error", error.returncode, error.stderr, error.cmd)


def old_success():
    return {
        "context": gate.CONTEXT,
        "state": "success",
        "description": "Codex review completed with no unresolved findings",
        "creator": {"login": gate.ACTIONS_LOGIN},
    }


SCENARIOS = {
    "clean review succeeds": (
        lambda: behavior.FakeGitHub([behavior.state_comment()]),
        False,
    ),
    "unresolved findings fail": (
        lambda: behavior.FakeGitHub([behavior.state_comment(unresolved=True)]),
        False,
    ),
    "null findings with receipt and threads": (
        lambda: behavior.FakeGitHub(
            [behavior.state_comment(unresolved=None), behavior.receipt()],
            threads=[behavior.thread(True)],
        ),
        False,
    ),
    "comment read failure blocks an older success": (
        lambda: behavior.FakeGitHub(
            [behavior.state_comment()], current=old_success(), read_error="comments"
        ),
        False,
    ),
    "invalidation marker is recorded": (
        lambda: behavior.FakeGitHub([behavior.state_comment()]),
        True,
    ),
    "failed invalidation marker publishes pending": (
        lambda: behavior.FakeGitHub([behavior.state_comment()], comment_error=True),
        True,
    ),
}


class AdapterContractTests(unittest.TestCase):
    def setUp(self):
        self.directory = tempfile.TemporaryDirectory()
        self.addCleanup(self.directory.cleanup)
        bin_dir = Path(self.directory.name) / "bin"
        bin_dir.mkdir()
        stub = bin_dir / "gh"
        stub.write_text(STUB, encoding="utf-8")
        stub.chmod(0o755)
        self.scenario = Path(self.directory.name) / "scenario.json"
        saved = {key: os.environ.get(key) for key in ("PATH", "STUB_GH_SCENARIO")}
        self.addCleanup(self.restore, saved)
        os.environ["PATH"] = f"{bin_dir}{os.pathsep}{os.environ.get('PATH', '')}"
        os.environ["STUB_GH_SCENARIO"] = str(self.scenario)

    @staticmethod
    def restore(saved):
        for key, value in saved.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value

    def test_real_adapter_matches_the_fake(self):
        for name, (make_fake, invalidate) in SCENARIOS.items():
            with self.subTest(name):
                recording = Recording(make_fake())
                expected = outcome(recording, invalidate)
                self.assertTrue(recording.steps)
                self.scenario.write_text(
                    json.dumps({"position": 0, "steps": recording.steps}),
                    encoding="utf-8",
                )
                actual = outcome(gate.gh, invalidate)
                consumed = json.loads(self.scenario.read_text(encoding="utf-8"))
                self.assertEqual(actual, expected)
                self.assertEqual(consumed["position"], len(recording.steps))

    def test_unexpected_call_fails_closed(self):
        self.scenario.write_text(
            json.dumps({"position": 0, "steps": []}), encoding="utf-8"
        )
        with self.assertRaises(subprocess.CalledProcessError) as caught:
            gate.gh("api", f"repos/{REPO}/pulls/9")
        self.assertEqual(caught.exception.returncode, 99)
        self.assertIn("unexpected gh call", caught.exception.stderr)


if __name__ == "__main__":
    unittest.main()
